DATABASE_URL=postgresql://postgres:password@localhost:5432/spaces
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
COOKIE_DOMAIN=localhost
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=spaces-dooh
DO_SPACES_CDN_URL=
RESEND_API_KEY=

# ─── apps/web (Next.js) — banderas de funcionalidad ─────────────────────────
# Ausente o cualquier valor distinto de '0' = HABILITADO. Cada una se comprueba
# en el cliente Y en el servidor: apagar solo la UI dejaría el endpoint abierto.

# Auto-registro público desde el login ("Crear cuenta"). Crea organización +
# usuario Dueño sin verificación de correo. Ponlo en 0 en cualquier despliegue
# expuesto a internet: hoy la demo pública y producción son el MISMO deploy
# sobre la misma base, así que un registro anónimo aterriza en datos reales.
NEXT_PUBLIC_AUTOREGISTRO=1

# Recuperar contraseña ("¿Olvidaste tu contraseña?"). Requiere correo saliente:
# `emailHabilitado()` (apps/web/lib/server/email.ts) exige RESEND_API_KEY **y**
# EMAIL_FROM. Con la bandera en 1 pero EMAIL_FROM vacío el usuario recibe
# "revisa tu bandeja" y no le llega nada — encender las dos cosas o ninguna.
NEXT_PUBLIC_RECUPERAR_PASSWORD=1
EMAIL_FROM=

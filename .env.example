DATABASE_URL=postgresql://postgres:password@localhost:5432/spaces
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
COOKIE_DOMAIN=localhost
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=spaces-dooh
DO_SPACES_CDN_URL=
RESEND_API_KEY=

# ─── apps/web (Next.js) — banderas de funcionalidad ─────────────────────────
# Ausente o cualquier valor distinto de '0' = HABILITADO. Cada una se comprueba
# en el cliente Y en el servidor: apagar solo la UI dejaría el endpoint abierto.

# Auto-registro público desde el login ("Crear cuenta"). Crea organización +
# usuario Dueño sin verificación de correo. Ponlo en 0 en cualquier despliegue
# expuesto a internet: hoy la demo pública y producción son el MISMO deploy
# sobre la misma base, así que un registro anónimo aterriza en datos reales.
NEXT_PUBLIC_AUTOREGISTRO=1

# Recuperar contraseña ("¿Olvidaste tu contraseña?"). Requiere correo saliente:
# `emailHabilitado()` (apps/web/lib/server/email.ts) exige RESEND_API_KEY **y**
# EMAIL_FROM. Con la bandera en 1 pero EMAIL_FROM vacío el usuario recibe
# "revisa tu bandeja" y no le llega nada — encender las dos cosas o ninguna.
NEXT_PUBLIC_RECUPERAR_PASSWORD=1
EMAIL_FROM=

# ─── ADR 0012 · Acceso con cuenta de Google ─────────────────────────────────
# OJO: esta bandera NO lleva prefijo NEXT_PUBLIC_, a diferencia de las de
# arriba, y es a propósito. Con el prefijo, Next la hornea en el build y
# apagarla exigiría RECOMPILAR, no solo reiniciar — la trampa documentada en
# HABILITAR_M11_RECUPERAR_PASSWORD.txt. El botón del login se pinta según lo
# que responda el servidor.
#
# Ausente o distinto de '0' = habilitado, PERO sin CLIENT_ID y CLIENT_SECRET no
# se enciende igualmente: ofrecer el botón sin credenciales lleva al usuario a
# un error de Google, que es peor que no ofrecerlo.
GOOGLE_OAUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El redirect URI que se registra en Google Cloud Console. LA BARRA FINAL NO ES
# OPCIONAL: `trailingSlash: true` alcanza también a las rutas /api (comprobado
# contra producción el 06/08/2026: /api/estado responde 308 y /api/estado/
# responde de verdad), y Google NO sigue redirecciones en el callback.
# Google compara esta URI carácter por carácter con la registrada.
#   producción : https://demo.space-os.io/spaces-dooh/api/auth/google/callback/
#   local      : http://localhost:3000/spaces-dooh/api/auth/google/callback/
# Si se deja vacía se deduce de APP_URL, pero conviene fijarla: deducirla detrás
# de nginx es justo donde se cuelan las diferencias de protocolo o puerto.
GOOGLE_REDIRECT_URI=

# SOLO para las pruebas de integración: apunta el canje del código a un doble
# local. El arnés levanta un Next real y no puede hablar con Google. NO fijar en
# producción.
GOOGLE_TOKEN_ENDPOINT=

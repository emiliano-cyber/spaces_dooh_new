    { "metodo": "GET", "ruta": "/api/sitios/[id]/space-eye", "nodo": "api-sitios", "auth": "sesión", "csrf": "n/a", "descripcion": "Visión de la cámara del sitio." },
    { "metodo": "POST", "ruta": "/api/arrendadores", "nodo": "api-arrendadores", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Alta de arrendador." },
    { "metodo": "PATCH|DELETE", "ruta": "/api/arrendadores/[id]", "nodo": "api-arrendadores", "auth": "sesión + permiso + candado estricto", "csrf": "requerido", "descripcion": "Edición y baja; los datos bancarios exigen reconfirmación incluso al Dueño." },
    { "metodo": "POST|PATCH", "ruta": "/api/predios · /api/predios/[id] · /api/predios/[id]/pantallas", "nodo": "api-arrendadores", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Predios y las pantallas que agrupan." },
    { "metodo": "POST|PATCH|DELETE", "ruta": "/api/razones-sociales · /[id]", "nodo": "api-arrendadores", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Razones sociales del arrendador." },
    { "metodo": "POST|PATCH|DELETE", "ruta": "/api/licencias · /[id]", "nodo": "api-arrendadores", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Licencias y permisos del sitio." },
    { "metodo": "POST|PATCH", "ruta": "/api/contratos · /[id]", "nodo": "api-contratos", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Alta y edición del contrato de arrendamiento." },
    { "metodo": "POST", "ruta": "/api/contratos/[id]/renovar · /cancelar", "nodo": "api-contratos", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Renovación y cancelación (abre OT de retiro)." },

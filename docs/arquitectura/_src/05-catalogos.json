    { "metodo": "GET", "ruta": "/api/integraciones", "nodo": "api-integraciones", "auth": "sesión", "csrf": "n/a", "descripcion": "Estado de los conectores externos." },
    { "metodo": "POST", "ruta": "/api/recordatorios", "nodo": "job-recordatorios", "auth": "token compartido (x-recordatorios-token)", "csrf": "n/a", "descripcion": "Barrido diario de contratos. 503 si el token no está configurado." }
  ],

  "database": [
    { "tabla": "tenants", "grupo": "identidad", "rls": "exenta (bootstrap)", "descripcion": "Organización. Guarda slug, moneda, razón social comercial y el hash del control de cambios.", "nodo": "db-identidad" },
    { "tabla": "usuarios", "grupo": "identidad", "rls": "fail-closed + FORCE", "descripcion": "Persona con rol y tenant. Se lee pre-sesión por funciones SECURITY DEFINER.", "nodo": "db-identidad" },
    { "tabla": "sesiones", "grupo": "identidad", "rls": "exenta (bootstrap)", "descripcion": "Token de sesión, expiración y desbloqueo del control de cambios.", "nodo": "db-identidad" },
    { "tabla": "rol_permisos", "grupo": "identidad", "rls": "por tenant", "descripcion": "Matriz rol × módulo × acción.", "nodo": "db-identidad" },
    { "tabla": "password_resets", "grupo": "identidad", "rls": "por tenant", "descripcion": "Token de restablecimiento de un solo uso, vence en 1 hora.", "nodo": "db-identidad" },
    { "tabla": "sitios", "grupo": "inventario", "rls": "por tenant", "descripcion": "Pantalla o espectacular: geo, tipo de medio, estatus comercial/legal/operativo, tarifa, slots, código de proveedor, pausa legal.", "nodo": "db-inventario" },
    { "tabla": "sitio_modalidades", "grupo": "inventario", "rls": "por tenant", "descripcion": "Formas de venta disponibles por sitio.", "nodo": "db-inventario" },
    { "tabla": "predios", "grupo": "inventario", "rls": "por tenant", "descripcion": "Inmueble que agrupa varias caras y comparte UN contrato.", "nodo": "db-inventario" },
    { "tabla": "arrendadores", "grupo": "arrendadores", "rls": "por tenant", "descripcion": "Propietario del predio o de la pantalla, con sus datos bancarios.", "nodo": "db-arrendadores" },
    { "tabla": "arrendador_razon_social", "grupo": "arrendadores", "rls": "por tenant", "descripcion": "Razones sociales con las que el arrendador factura la renta.", "nodo": "db-arrendadores" },
    { "tabla": "contratos_arrendamiento", "grupo": "arrendadores", "rls": "por tenant", "descripcion": "Contrato con vigencia, importe, periodicidad y estatus (incluido INCOMPLETO). Unicidad por sitio y por predio activo.", "nodo": "db-arrendadores" },
    { "tabla": "pagos_renta", "grupo": "arrendadores", "rls": "por tenant", "descripcion": "Una fila por periodo, anclada al inicio del contrato, con comprobante y factura.", "nodo": "db-arrendadores" },
    { "tabla": "licencias", "grupo": "arrendadores", "rls": "por tenant", "descripcion": "Licencias y permisos del sitio con su vencimiento.", "nodo": "db-arrendadores" },

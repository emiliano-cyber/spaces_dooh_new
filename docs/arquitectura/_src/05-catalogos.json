{
  "modules": [
    { "id": "mod-auth", "nombre": "Autenticación y sesión", "nodos": ["api-auth", "api-signup", "infra-auth", "ui-login", "ui-recuperar", "ctrl-cuentas"], "rutas": ["/login", "/recuperar/[token]"], "descripcion": "Login, autorregistro, recuperación de contraseña, sesión por cookie httpOnly y token anti-CSRF." },
    { "id": "mod-inventario", "nombre": "Inventario", "nodos": ["ui-inventario", "ui-network", "ui-disponibilidad", "api-sitios", "ctrl-sitios", "repo-sitios", "repo-contratos-sitio", "db-inventario"], "rutas": ["/inventario", "/network", "/disponibilidad"], "descripcion": "Pantallas y espectaculares: alta manual, importación masiva, modalidades de venta, publicación a la red y disponibilidad." },
    { "id": "mod-arrendadores", "nombre": "Arrendadores y contratos", "nodos": ["ui-arrendadores", "ui-contrato", "ui-firmar", "api-arrendadores", "api-contratos", "api-pagos-renta", "api-firma", "ctrl-arrendadores", "repo-arrendadores", "repo-firmas", "db-arrendadores"], "rutas": ["/arrendadores", "/contrato/[id]", "/firmar/[token]"], "descripcion": "Propietarios, razones sociales, predios, contratos con calendario de renta, licencias, firma electrónica e incidencias." },
    { "id": "mod-comercial", "nombre": "Comercial y propuestas", "nodos": ["ui-comercial", "ui-propuestas", "ui-clientes", "ui-propuesta-publica", "api-propuestas", "api-reservar", "api-clientes", "ctrl-propuestas", "ctrl-reservas", "repo-propuestas", "repo-campanas", "db-comercial"], "rutas": ["/comercial", "/propuestas", "/clientes", "/p/[id]", "/propuesta"], "descripcion": "Venta sobre mapa, cotización con comisión y descuento, enlace compartible y aceptación pública." },
    { "id": "mod-campanas", "nombre": "Campañas y creativos", "nodos": ["ui-campanas", "ui-creativos", "ui-portal", "api-campanas", "api-creatividades", "api-portal", "ctrl-campanas", "ctrl-creativos", "repo-campanas", "repo-creativos", "repo-portal", "repo-playlogs"], "rutas": ["/campanas", "/campanas/[id]", "/creativos", "/portal/[token]"], "descripcion": "Pipeline de la campaña, arte, validación de publicación, publicación en DOOHmain, proof of play y portal del cliente." },
    { "id": "mod-operaciones", "nombre": "Operaciones e imprenta", "nodos": ["ui-operaciones", "ui-ot-movil", "ui-imprenta", "ui-almacen", "api-ot", "api-impresion", "api-almacen", "ctrl-ot", "ctrl-impresion", "repo-ot", "repo-impresion", "repo-eventos-op", "db-operaciones"], "rutas": ["/operaciones", "/operaciones/ot/[id]", "/m/ot/[id]", "/imprenta", "/almacen"], "descripcion": "Órdenes de trabajo con SLA, evidencia fotográfica, producción de lonas y almacén de activos." },
    { "id": "mod-finanzas", "nombre": "Finanzas", "nodos": ["ui-finanzas", "ui-comisiones", "api-finanzas", "ctrl-finanzas", "repo-finanzas", "db-finanzas"], "rutas": ["/finanzas", "/comisiones"], "descripcion": "Facturación con candado de evidencia, cobranza con antigüedad y parcialidades, pagos de renta y comisiones." },
    { "id": "mod-admin", "nombre": "Administración y configuración", "nodos": ["ui-administracion", "ui-configuracion", "ui-actividad", "ui-integraciones", "api-usuarios", "api-tenants", "api-cambios", "api-config", "api-integraciones", "ctrl-usuarios", "repo-usuarios", "repo-config", "repo-acciones", "infra-cambios"], "rutas": ["/administracion", "/configuracion", "/actividad", "/integraciones"], "descripcion": "Usuarios y permisos, organizaciones, control de cambios, parámetros del negocio, bitácora y estado de conectores." },
    { "id": "mod-plataforma", "nombre": "Plataforma", "nodos": ["middleware", "next-config", "infra-db", "infra-tenant", "infra-errores", "infra-uploads", "infra-ratelimit", "infra-storage", "infra-email", "db-rls", "db-funciones"], "rutas": ["*"], "descripcion": "Multi-tenant con RLS, validación de entrada y subidas, límites de intentos, correo, almacenamiento y mapeo de errores." }
  ],

  "services": [
    { "id": "svc-bff", "nombre": "BFF de Next.js", "tipo": "interno", "descripcion": "81 route handlers en apps/web/app/api. Corre en el mismo proceso que el frontend, bajo pm2.", "entrada": "/spaces-dooh/api/**", "runtime": "nodejs", "nodos": ["api-auth", "api-estado", "api-sitios", "api-campanas", "api-propuestas", "api-arrendadores", "api-ot", "api-finanzas"] },
    { "id": "svc-doohmain", "nombre": "DOOHmain SDK", "tipo": "subproceso", "descripcion": "Paquete Python invocado con execFile. Contrato JSON por stdout, timeout de 120 s, idempotente contra sus propias tablas.", "entrada": "python -m doohmain_sdk {publish|stats|metrics|retirar}", "runtime": "python3", "nodos": ["infra-doohmain", "ext-doohmain-sdk"] },
    { "id": "svc-spaceeye", "nombre": "Space Eye", "tipo": "externo", "descripcion": "API REST con JWT de las cámaras de verificación instaladas en los espectaculares.", "entrada": "SPACE_EYE_BASE_URL", "runtime": "http", "nodos": ["infra-spaceeye", "ext-spaceeye"] },
    { "id": "svc-resend", "nombre": "Resend", "tipo": "externo", "descripcion": "Correo transaccional por REST.", "entrada": "https://api.resend.com/emails", "runtime": "http", "nodos": ["infra-email", "ext-resend"] },
    { "id": "svc-spaces", "nombre": "DigitalOcean Spaces", "tipo": "externo", "descripcion": "Almacenamiento S3-compatible con objetos privados y URLs firmadas.", "entrada": "DO_SPACES_ENDPOINT", "runtime": "s3", "nodos": ["infra-storage", "ext-spaces"] },
    { "id": "svc-postgres", "nombre": "PostgreSQL", "tipo": "datos", "descripcion": "Una sola base compartida por todos los tenants, aislada con RLS. En desarrollo, Docker en el puerto 5433.", "entrada": "DATABASE_URL", "runtime": "postgres", "nodos": ["db-postgres", "infra-db"] }
  ],

  "apis": [
    { "metodo": "POST", "ruta": "/api/auth/login", "nodo": "api-auth", "auth": "pública (bootstrap)", "csrf": "exenta", "descripcion": "Inicia sesión y emite las cookies de sesión y CSRF.", "limites": "10 intentos / IP / 5 min" },
    { "metodo": "GET", "ruta": "/api/auth/me", "nodo": "api-auth", "auth": "sesión", "csrf": "n/a", "descripcion": "Usuario en sesión y sus permisos." },
    { "metodo": "POST", "ruta": "/api/auth/logout", "nodo": "api-auth", "auth": "sesión", "csrf": "exenta", "descripcion": "Destruye la sesión." },
    { "metodo": "POST", "ruta": "/api/auth/forgot", "nodo": "api-auth", "auth": "pública", "csrf": "exenta", "descripcion": "Solicita el correo de restablecimiento.", "limites": "por IP" },
    { "metodo": "GET|POST", "ruta": "/api/auth/reset", "nodo": "api-auth", "auth": "token", "csrf": "exenta", "descripcion": "Valida el token y fija la contraseña nueva." },
    { "metodo": "POST", "ruta": "/api/signup", "nodo": "api-signup", "auth": "pública", "csrf": "exenta", "descripcion": "Crea organización y usuario Dueño.", "limites": "por IP · bandera NEXT_PUBLIC_AUTOREGISTRO" },
    { "metodo": "GET", "ruta": "/api/estado", "nodo": "api-estado", "auth": "sesión", "csrf": "n/a", "descripcion": "23 rebanadas del negocio filtradas por permisos del rol." },
    { "metodo": "GET|POST", "ruta": "/api/sitios", "nodo": "api-sitios", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Lista y alta de pantallas." },
    { "metodo": "PATCH|DELETE", "ruta": "/api/sitios/[id]", "nodo": "api-sitios", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Edición y baja de pantalla." },
    { "metodo": "POST", "ruta": "/api/sitios/import", "nodo": "api-sitios", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Importación masiva desde Excel." },
    { "metodo": "POST|DELETE", "ruta": "/api/sitios/[id]/pausa-legal", "nodo": "api-sitios", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Pausa y reanudación por problema legal." },

    { "metodo": "GET|POST", "ruta": "/api/firma/[token]", "nodo": "api-firma", "auth": "token público", "csrf": "exenta", "descripcion": "Documento congelado y firma del arrendador." },
    { "metodo": "PATCH", "ruta": "/api/pagos-renta/[id]", "nodo": "api-pagos-renta", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Editar el periodo de renta." },
    { "metodo": "POST", "ruta": "/api/pagos-renta/[id]/pagar", "nodo": "api-pagos-renta", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Registrar el pago con comprobante." },
    { "metodo": "GET", "ruta": "/api/pagos-renta/[id]/adjunto/[tipo]", "nodo": "api-pagos-renta", "auth": "sesión + permiso", "csrf": "n/a", "descripcion": "URL firmada del comprobante o de la factura." },
    { "metodo": "POST|PATCH", "ruta": "/api/propuestas · /[id]", "nodo": "api-propuestas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Crear propuesta y cambiar su estatus." },
    { "metodo": "PATCH", "ruta": "/api/propuestas/items/[id]", "nodo": "api-propuestas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Aprobar o ajustar un ítem." },
    { "metodo": "POST", "ruta": "/api/propuestas/[id]/generar-campana", "nodo": "api-propuestas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Convierte la propuesta aprobada en campaña. Idempotente." },

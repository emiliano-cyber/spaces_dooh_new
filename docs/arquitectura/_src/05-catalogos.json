    { "metodo": "POST", "ruta": "/api/reservar", "nodo": "api-reservar", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Reserva transaccional con FOR UPDATE." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/confirmar", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Tentativa → confirmada; sitios a ocupado." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/enviar-dominio", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Manda la campaña a revisión de publicación." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/validar", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Aprueba o rechaza; al aprobar publica en DOOHmain." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/oc", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Registra la orden de compra del anunciante." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/contrato", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Adjunta el contrato de la campaña." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/extender", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Extiende la fecha fin de campaña y reservas." },
    { "metodo": "POST", "ruta": "/api/campanas/[id]/facturar", "nodo": "api-campanas", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Genera la factura si el candado de evidencia está completo." },
    { "metodo": "GET|POST", "ruta": "/api/campanas/[id]/playlogs", "nodo": "api-campanas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Consulta y guarda el proof of play." },
    { "metodo": "POST", "ruta": "/api/creatividades", "nodo": "api-creatividades", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Sube la pieza (imagen 15 MB o HTML 2 MB)." },
    { "metodo": "PATCH|PUT|DELETE", "ruta": "/api/creatividades/[id]", "nodo": "api-creatividades", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Valida, reemplaza o retira; avisa a DOOHmain." },
    { "metodo": "PATCH", "ruta": "/api/reservas/[id]/creativo", "nodo": "api-creatividades", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Asigna creativos a una reserva." },
    { "metodo": "GET|POST", "ruta": "/api/ot", "nodo": "api-ot", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Lista y alta de órdenes de trabajo." },
    { "metodo": "GET", "ruta": "/api/ot/[id]", "nodo": "api-ot", "auth": "sesión + permiso", "csrf": "n/a", "descripcion": "OT completa con evidencias." },
    { "metodo": "POST", "ruta": "/api/ot/[id]/cerrar", "nodo": "api-ot", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Cierra con fotos validadas; enciende el candado físico." },
    { "metodo": "GET|POST|PATCH", "ruta": "/api/impresion · /[id] · /[id]/prueba-color", "nodo": "api-impresion", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Órdenes de impresión y su avance." },
    { "metodo": "GET|POST", "ruta": "/api/almacen · /[id]/movimiento", "nodo": "api-almacen", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Activos y movimientos de almacén." },
    { "metodo": "POST", "ruta": "/api/cobranzas/[id]/pagar", "nodo": "api-finanzas", "auth": "sesión + permiso + candado", "csrf": "requerido", "descripcion": "Registra el pago del cliente, total o parcial." },
    { "metodo": "POST", "ruta": "/api/cobranzas/[id]/recordar", "nodo": "api-finanzas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Recordatorio manual de cobro." },
    { "metodo": "POST", "ruta": "/api/ordenes-compra", "nodo": "api-finanzas", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Alta de orden de compra." },
    { "metodo": "POST|PATCH", "ruta": "/api/clientes · /[id]", "nodo": "api-clientes", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Clientes y agencias con datos fiscales." },
    { "metodo": "POST", "ruta": "/api/incidencias", "nodo": "api-incidencias", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Reporta incidencia sobre un sitio." },
    { "metodo": "GET|POST", "ruta": "/api/notificaciones/nuevas · /[id]/leer · /leer-todas", "nodo": "api-notificaciones", "auth": "sesión", "csrf": "requerido en mutaciones", "descripcion": "Buzón de eventos." },
    { "metodo": "GET|PATCH", "ruta": "/api/config", "nodo": "api-config", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Configuración del negocio y logo." },
    { "metodo": "PATCH", "ruta": "/api/organizacion", "nodo": "api-config", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Nombre de la organización." },
    { "metodo": "PATCH", "ruta": "/api/perfil", "nodo": "api-config", "auth": "sesión", "csrf": "requerido", "descripcion": "Perfil propio y cambio de contraseña." },
    { "metodo": "GET|POST|PATCH|DELETE", "ruta": "/api/usuarios · /[id]", "nodo": "api-usuarios", "auth": "sesión + permiso", "csrf": "requerido", "descripcion": "Usuarios del tenant." },
    { "metodo": "GET", "ruta": "/api/permisos · /api/admin/permisos-matriz", "nodo": "api-usuarios", "auth": "sesión", "csrf": "n/a", "descripcion": "Permisos del rol y matriz completa." },
    { "metodo": "GET|POST", "ruta": "/api/tenants", "nodo": "api-tenants", "auth": "sesión + super-admin", "csrf": "requerido", "descripcion": "Lista y crea organizaciones." },
    { "metodo": "POST", "ruta": "/api/tenant-activo", "nodo": "api-tenants", "auth": "super-admin", "csrf": "requerido", "descripcion": "Cambia el CRM activo por cookie." },
    { "metodo": "GET|PUT", "ruta": "/api/cambios", "nodo": "api-cambios", "auth": "sesión (PUT: Dueño)", "csrf": "requerido", "descripcion": "Estado y contraseña del control de cambios." },
    { "metodo": "POST|DELETE", "ruta": "/api/cambios/desbloquear", "nodo": "api-cambios", "auth": "sesión", "csrf": "requerido", "descripcion": "Desbloquea o bloquea la sesión.", "limites": "por IP" },

NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_dev_2026
DB_NAME=space_eye

# Redis
REDIS_URL=redis://127.0.0.1:6379

# ai-worker: secreto compartido para /api/internal/* y URL publica del backend
# usada para construir enlaces descargables a fotos/creatividades (modo local).
WORKER_SECRET=change_me_worker_shared_secret_min_16_chars
PUBLIC_BASE_URL=http://127.0.0.1:4000

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_random_64_char_string_at_least_32_characters_long
JWT_DEVICE_SECRET=change_me_to_another_random_string_at_least_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_DEVICE_TTL=365d

# DigitalOcean Spaces / S3 (for photo storage)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=your_spaces_key
SPACES_SECRET=your_spaces_secret
SPACES_BUCKET=space-eye-photos
SPACES_REGION=nyc3

# MediaSoup (WebRTC)
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

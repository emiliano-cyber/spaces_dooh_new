# SPACE EYE — .env de PRODUCCION (copia a backend/.env y completa)
NODE_ENV=production
PORT=4000

# Dominio (usado por Caddy para el HTTPS automatico)
DOMAIN=espaceeye.tudominio.com

# MySQL (host = nombre del servicio en compose)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_un_password_fuerte
DB_NAME=space_eye

# Redis (host = servicio en compose)
REDIS_URL=redis://redis:6379

# JWT — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_64_hex_min_32_chars
JWT_DEVICE_SECRET=cambia_esto_otro_64_hex_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_DEVICE_TTL=365d

# Almacenamiento de fotos. 'local' guarda en el volumen; 'spaces' sube a S3/DO.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Secreto compartido con el ai-worker
WORKER_SECRET=cambia_esto_worker_secret

# URL publica del backend (para enlaces a fotos/evidencia)
PUBLIC_BASE_URL=https://espaceeye.tudominio.com

# TURN (WebRTC remoto). TURN_SECRET debe ser IGUAL a static-auth-secret de coturn.
# genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_URL=turn:espaceeye.tudominio.com:3478
TURN_SECRET=cambia_esto_turn_secret_igual_que_coturn

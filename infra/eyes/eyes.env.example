# ============================================================================
#  /etc/space-os/eyes.env — Space Eyes de ESTA instancia (ADR 0041).  600, root.
# ----------------------------------------------------------------------------
#  Lo escribe el alta (instalar-hijo.sh / provision-instancia.sh) una sola vez.
#  Formato `docker --env-file`: CLAVE=valor, SIN comillas y sin `export`. Lo leen
#  el compose de infra/eyes y update-eyes.sh.
#
#  Los secretos salen de `openssl rand -hex 32`. Las dos credenciales de abajo
#  (INSTANCIA_LLAVE, INSTANCIA_TESTIGO) se escriben IGUALES en app.env como
#  SPACE_EYE_KEY y SPACE_EYE_PROVISION_TOKEN: Space Eye las registra al arrancar
#  y nadie tiene que copiar nada de un lado a otro.
# ============================================================================

# ─── Quién es ────────────────────────────────────────────────────────────────
# El dueño: todo equipo que se da de alta en este Space Eye es de esta empresa.
INSTANCIA_OWNER=
# Por donde entran los equipos: eyes.<dominio de la instancia>. Mismo
# certificado que el dominio de la app, con este segundo nombre.
EYES_DOMINIO=
# La IP pública del droplet: la anuncian MediaMTX y coturn a los equipos.
IP_PUBLICA=

# ─── Qué versión corre ───────────────────────────────────────────────────────
# Vacío = la del canal de la instancia: $REGISTRY/space-os:eyes-$CANAL (de
# instancia.env). Solo se fija a mano para ensayar una versión concreta.
EYES_IMAGEN=

# ─── Credenciales con SPACE OS (las mismas que en app.env) ──────────────────
#  Formato: se_<12 hex>_<secreto de 43>. Generarlas con:
#    echo "se_$(openssl rand -hex 6)_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
INSTANCIA_LLAVE=
INSTANCIA_TESTIGO=

# ─── El panel de operación (nosotros) ───────────────────────────────────────
# Solo se usa si todavía no hay ningún usuario. Cambiarla al primer ingreso.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Secretos internos ───────────────────────────────────────────────────────
DB_PASSWORD=
JWT_SECRET=
JWT_DEVICE_SECRET=
WORKER_SECRET=
MEDIAMTX_PASS=
TURN_SECRET=

# ─── Solo para adoptar una base que ya existía (una sola vez) ───────────────
# Al traer la base de cámaras de otro Space Eye (g500 desde 159.203.188.58), la
# última migración que esa base ya tenía. Vacío en una instancia nueva.
MIGRACIONES_BASE=

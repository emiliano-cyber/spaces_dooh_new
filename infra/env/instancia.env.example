# ============================================================================
#  instancia.env — configuración del ACTUALIZADOR de una instancia.
#  Destino en el servidor: /etc/space-os/instancia.env
# ----------------------------------------------------------------------------
#  Lo lee `infra/scripts/update.sh` (`:306`), que corre por `cron` y jala la
#  versión nueva del canal que esta instancia sigue.
#
#  ─── Por qué está separado de `app.env` ────────────────────────────────────
#  Son dos consumidores distintos con necesidades distintas. `update.sh` lo
#  hace `source` en bash, así que todo lo que esté aquí acaba en SU entorno.
#  Las credenciales de correo, las de Google y el token de arranque no le
#  sirven de nada, y meterlas aquí solo ampliaría lo que queda expuesto si este
#  archivo se filtra. Van en `app.env`, que el actualizador pasa al contenedor
#  con `--env-file` sin leerlo.
#
#  Sí lleva `DATABASE_URL`, y NO es la misma que la de la aplicación: aquí va
#  la PRIVILEGIADA, la que puede migrar y respaldar. La de la app es el rol
#  `spaces_app`, sin DDL y sin saltarse la RLS.
#
#  ─── Cómo se usa ───────────────────────────────────────────────────────────
#  Se copia, se rellena y se deja en /etc/space-os/instancia.env con permisos
#  600. Lleva secretos: no se versiona nunca con valores dentro.
#
#  Ningún valor de este archivo trae un dominio, una IP encaminable ni un token
#  real. Hay una prueba que lo comprueba (`apps/web/lib/entorno.test.ts`, F5.3).
# ============================================================================


# ─── El canal ───────────────────────────────────────────────────────────────
# `estable` o `beta`. Una instancia de owner sigue SIEMPRE `estable`.
#
# `beta` es para el banco de pruebas interno, y no es una preferencia: el
# invariante 13 dice que ninguna tarea corre en la instancia de un owner sin
# pasar antes por ahí. Un owner en `beta` es un owner haciendo de conejillo.
CANAL=estable

# De dónde se jala la imagen. Se deja VACÍO a propósito en la plantilla: el
# nombre del registry todavía no está decidido (TH-P4), y escribir uno
# inventado haría que la primera instancia fallara con un error de red en vez
# de con un error de configuración.
REGISTRY=

IMAGEN_NOMBRE=space-os
CONTENEDOR=space-os


# ─── La base de datos, con el rol PRIVILEGIADO ──────────────────────────────
# Migraciones y respaldo. NO es la de la aplicación.
#
# LA CLAVE VA SIEMPRE PERCENT-ENCODED: %40 por @, %2F por /, %3F por ? y %5C
# por la barra invertida. Sin codificar, cada cliente se rompe con un carácter
# distinto —medido el 19/08— y además bash hace `source` de este archivo.
DATABASE_URL=


# ─── Dónde están las variables de la aplicación ─────────────────────────────
# El actualizador no las lee: se las pasa al contenedor con `--env-file`.
ENV_APP=/etc/space-os/app.env

DOCKER_OPCIONES_APP="--publish 127.0.0.1:3000:3000"
RED_MIGRACION=host


# ─── Comprobación de salud tras actualizar ──────────────────────────────────
# Contra el propio proceso, por loopback: la máquina se pregunta a sí misma si
# la versión nueva levantó. Por eso es `127.0.0.1` y no el dominio del owner —
# preguntarlo por fuera metería en la ecuación el DNS, nginx y el certificado,
# que no es lo que se está comprobando.
SALUD_URL=http://127.0.0.1:3000/spaces-dooh/api/auth/metodos/
SALUD_INTENTOS=10
SALUD_ESPERA=3

# Esperas entre reintentos del `pull`, en segundos. Vacío = ninguna.
PULL_ESPERAS="1 5 30"


# ─── Herramientas ───────────────────────────────────────────────────────────
RUNNER_MIGRACIONES=/opt/space-os/migrar.mjs
PG_DUMP=pg_dump
PG_RESTORE=pg_restore


# ─── Respaldos y registro de corridas ───────────────────────────────────────
# `INSTANCIA` es el prefijo de esta instancia dentro del bucket, y es lo que
# mantiene separados los respaldos de dos owners.
INSTANCIA=

# La llave de Spaces es UNA POR INSTANCIA y con permiso solo sobre SU prefijo.
# Nunca la llave maestra de la cuenta: una instancia comprometida no puede
# poder leer ni borrar los respaldos de las demás.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
LOGS_BUCKET=

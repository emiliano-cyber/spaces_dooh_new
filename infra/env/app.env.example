# ============================================================================
#  app.env — variables de la APLICACIÓN de una instancia de owner.
#  Destino en el servidor: /etc/space-os/app.env
# ----------------------------------------------------------------------------
#  Este archivo, junto con `instancia.env` y la base de datos, es LO ÚNICO que
#  distingue una instancia de otra. El artefacto es idéntico para toda la flota
#  (invariante 3): si algo tiene que cambiar entre dos owners y no está aquí,
#  está mal puesto.
#
#  Lo carga el proceso de la aplicación. `update.sh` lo pasa como `--env-file`
#  y NO lo lee él mismo — su propia configuración vive en `instancia.env`.
#
#  ─── Cómo se usa ───────────────────────────────────────────────────────────
#  Se copia, se rellenan los valores y se deja en /etc/space-os/app.env con
#  permisos 600. Lleva secretos: no se versiona nunca con valores dentro.
#
#  ─── Sobre los ejemplos de este archivo ────────────────────────────────────
#  Los dominios que aparecen en los COMENTARIOS son inventados y solo sirven de
#  ejemplo. Ningún VALOR trae un dominio, una IP ni un token real: hay una
#  prueba que lo comprueba (`apps/web/lib/entorno.test.ts`, F5.3).
# ============================================================================


# ─── El dominio de acceso ───────────────────────────────────────────────────
# El dominio que el owner eligió y apunta en SU propio DNS. AS OOH nunca toca
# la zona del owner.
#
# Se usa para construir los enlaces que salen por correo y para la vuelta de
# Google, o sea que un valor equivocado no rompe la aplicación: manda a la
# gente a otro sitio. Lo leen `app/api/auth/forgot/route.ts:50`,
# `app/api/auth/google/callback/route.ts:61` y `app/api/recordatorios/route.ts`.
#
# Sin barra final, y con https.
APP_URL=https://inventario.ejemplo.com


# ─── Base de datos ──────────────────────────────────────────────────────────
# El rol de la APLICACIÓN, que es `NOSUPERUSER NOBYPASSRLS`. NO el de
# migraciones y NO `postgres`.
#
# Esto no es una recomendación: la RLS es la defensa en profundidad dentro de
# cada instancia, y un superusuario la ATRAVIESA sin dar ningún error. Una
# instancia que arranque con el rol equivocado funciona perfectamente y sin
# aislamiento, que es la peor combinación posible.
DATABASE_URL=postgresql://spaces_app:CAMBIAME@127.0.0.1:5432/spaces


# ─── Cookies ────────────────────────────────────────────────────────────────
# Con `=1` las cookies de sesión salen con `Secure`. En una instancia con
# certificado esto es SIEMPRE 1. Lo lee `lib/server/auth.ts:198`.
COOKIE_SECURE=1

# COOKIE_DOMAIN NO EXISTE, y su ausencia es deliberada (invariante 4 del plan
# v3). Las cookies de sesión no llevan `domain`, así que cada instancia queda
# encerrada en su propio host. Poner un dominio aquí las compartiría entre
# subdominios — que es justo lo que el modelo de instancias soberanas evita.
# No se añade "por si acaso": nada lo lee y ponerlo no haría nada, salvo el día
# que alguien decida hacer que lo lea.


# ─── Registro de cuentas ────────────────────────────────────────────────────
# Cerrado en TODA la flota desde el 2026-08-14. El Dueño de la instancia da de
# alta a su equipo; nadie se registra solo.
#
# Solo `1` enciende: un `AUTOREGISTRO=true` o `=si` deja el registro CERRADO
# (`apps/web/lib/entorno.ts:27`). Ausente también es cerrado.
#
# Ojo con el nombre: es `AUTOREGISTRO`, SIN el prefijo `NEXT_PUBLIC_`. La
# variable con prefijo existió y se retiró a propósito — Next inlinea las
# `NEXT_PUBLIC_*` al compilar, así que con aquella una instancia no podía
# cambiar esta bandera en su `.env`: venía escrita en el artefacto.
AUTOREGISTRO=0


# ─── Recuperar contraseña ───────────────────────────────────────────────────
# `0` apaga el «¿olvidaste tu contraseña?». Requiere correo saliente, así que
# si no hay `RESEND_API_KEY` esto va apagado o el enlace lleva a un error.
# Lo leen `app/(app)/login/page.tsx:24` y `app/api/auth/forgot/route.ts:18`.
NEXT_PUBLIC_RECUPERAR_PASSWORD=0


# ─── Correo saliente ────────────────────────────────────────────────────────
# Remitente y clave de Resend. Sin los dos, la recuperación de contraseña y los
# recordatorios no salen.
EMAIL_FROM=SPACE OS <no-responder@ejemplo.com>
RESEND_API_KEY=


# ─── Entrar con Google ──────────────────────────────────────────────────────
# Opcional. Con `GOOGLE_OAUTH` distinto de `1`, el botón no aparece y el
# endpoint responde 503 — se decide en el servidor, no en el build.
GOOGLE_OAUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LA BARRA FINAL NO ES OPCIONAL. La aplicación corre con `trailingSlash: true`,
# así que Google tiene que devolver a la URL CON barra. Sin ella, Google
# redirige a la versión sin barra, Next responde un 308 al mismo sitio con
# barra, y el código de un solo uso se gasta en el salto: el usuario vuelve al
# login sin ningún mensaje de error.
#
# Este valor tiene que coincidir CARÁCTER A CARÁCTER con el que esté dado de
# alta en la consola de Google Cloud para esta instancia.
GOOGLE_REDIRECT_URI=https://inventario.ejemplo.com/spaces-dooh/api/auth/google/callback/


# ─── Arranque de la instancia ───────────────────────────────────────────────
# La clave de UN SOLO USO que deja crear la primera organización y su Dueño en
# una instancia recién aprovisionada, por `POST /api/bootstrap`.
#
# Se genera aleatoria en el aprovisionamiento y se pone aquí. Vacía o ausente
# = la ruta no existe (responde 404, indistinguible de una URL inventada).
#
# NO hace falta acordarse de borrarla después: la puerta se cierra sola en
# cuanto existe la primera organización, porque uno de sus tres cerrojos es que
# la tabla `tenants` esté vacía. Retirarla es defensa en profundidad, no el
# cerrojo.
BOOTSTRAP_TOKEN=


# ─── Recordatorios programados ──────────────────────────────────────────────
# Clave que autoriza al `cron` a llamar al endpoint de recordatorios. Sin ella
# el endpoint queda abierto a cualquiera que conozca la URL.
RECORDATORIOS_TOKEN=


# ─── Panel de flota ─────────────────────────────────────────────────────────
# La clave con la que el panel de AS OOH pregunta `GET /api/version` y obtiene
# la versión, la última migración y el canal.
#
# Vacía o ausente = NADIE es el panel: la ruta sigue contestando, pero solo
# `{ ok }`. Se comporta igual con un desconocido que con un token equivocado,
# a propósito — publicar la versión exacta le ahorra el trabajo a quien busca
# una vulnerabilidad conocida de esa versión.
#
# Lo que esa ruta NO devuelve, con token o sin él: ni una organización, ni un
# conteo, ni un dato del negocio del owner. El panel es de AS OOH y la
# instancia es del owner.
FLOTA_TOKEN=

# El canal que sigue esta instancia. Repetido a propósito en `instancia.env`:
# allí lo usa el actualizador para decidir qué imagen jala, y aquí lo lee la
# aplicación solo para poder DECIRLO en `/api/version`.
#
# La alternativa —que la aplicación abriera `/etc/space-os/instancia.env`— se
# descartó: ese archivo lleva la conexión privilegiada de Postgres y las llaves
# de Spaces, y no se abre para sacar un campo que no es secreto.
CANAL=estable


# ─── Zona horaria ───────────────────────────────────────────────────────────
# La del owner, no la del servidor. Afecta a cómo se leen las fechas de
# campañas y facturación.
TZ=America/Mexico_City

# ============================================================================
#  PUBLICAR A PANTALLAS (DOOHmain)
# ----------------------------------------------------------------------------
#  La aplicación publica invocando por subproceso el SDK de Python que viaja
#  DENTRO de la imagen. `DOOHMAIN_PY` y `DOOHMAIN_SDK_DIR` NO se ponen aquí: las
#  fija el `Dockerfile`, porque son rutas de la imagen y no de la instancia.
#
#  ⚠️ Seis de estas variables NO tienen valor por omisión: `doohmain_sdk/
#  config.py:52-60` las lee con `os.environ[...]`, que revienta si faltan.
# ============================================================================

# El interruptor. Nace APAGADO a propósito: una instancia sin llave de DOOHmain
# no debe intentar publicar, porque fallaría en cada campaña. Se pone a 1 el día
# que el owner entrega su `DOOHMAIN_API_KEY`.
DOOHMAIN_PUBLISH_ENABLED=0

# La llave es DEL OWNER, no de AS OOH: la da él, la pide Comercial en el alta.
DOOHMAIN_API_KEY=

# Solo si el owner usa otra instalación de DOOHmain. Vacío = la de siempre.
# DOOHMAIN_BASE_URL=https://app.doohmain.com/api/v1/index.php

# A qué pantalla va lo que no trae destino, y el mapa de las que sí.
# `SCREEN_MAP` es JSON: {"codigo-de-pantalla": "id-en-doohmain"}
DOOHMAIN_DEFAULT_SCREEN=
DOOHMAIN_SCREEN_MAP={}

# ─── La conexión que usa el SDK ────────────────────────────────────────────
#  Es LA MISMA BASE que `DATABASE_URL`, escrita en otro formato porque el SDK
#  la lee por piezas. Si cambias una, cambia la otra: son dos copias de lo
#  mismo, y este proyecto sabe lo que pasa cuando dos copias divergen.
#  Aquí van las tablas de seguimiento que sostienen la idempotencia de las
#  publicaciones — sin ellas, reintentar una campaña la publica dos veces.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=spaces_app
DB_PASSWORD=
DB_NAME=spaces
DB_SSL=0

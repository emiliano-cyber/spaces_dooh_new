exports[`diccionario de administracion · instantanea > el INGLES tampoco 1`] = `
{
  "admin.act.aprobada": "Installation approved: it will be installed in the next few minutes",
  "admin.act.automatica": "Automatic",
  "admin.act.aviso-sin-notas": "The notes for {version} didn’t arrive, so you can’t see here what’s in it. Let support know before approving it: it’s almost always the server’s updater, not the version.",
  "admin.act.comprobado": "Checked:",
  "admin.act.con-aprobacion": "With approval",
  "admin.act.confirmar": "You’re about to install {version}. {migraciones}.{sinNotas} The service goes down while the installation runs.",
  "admin.act.confirmar-sin-notas": " Its notes didn’t arrive: you don’t know what’s in it.",
  "admin.act.disponible": "Available:",
  "admin.act.error": "The update status could not be loaded.",
  "admin.act.error.aprobar": "The installation could not be approved",
  "admin.act.error.modo": "The mode could not be changed",
  "admin.act.estado.al-dia": "Up to date: running {version}, the same one that is available.",
  "admin.act.estado.aprobada": "You approved {version}: it will be installed in the next few minutes, or overnight ({hora}) at the latest.",
  "admin.act.estado.automatica": "{version} is available. It will install by itself in the next automatic window, overnight ({hora}).",
  "admin.act.estado.esperando": "A new version is available: {version}. Waiting for your approval to install it.",
  "admin.act.estado.la-instalada": "the installed version",
  "admin.act.estado.otra-aprobada": "What you approved is no longer what’s available: a newer version came out, {version}. Approve again to install it.",
  "admin.act.estado.sin-comprobar": "This instance hasn’t been checked against the registry yet: it’s not known whether there is a new version.",
  "admin.act.estado.sin-digest": "It was checked against the registry, but the updater could not read the image digest: there is nothing to approve, and this instance can’t install a new version until it’s looked into. Let whoever runs the server know.",
  "admin.act.estado.una-nueva": "a new version",
  "admin.act.instalada": "Installed:",
  "admin.act.instalar": "Install",
  "admin.act.instalar-version": "Install {version}",

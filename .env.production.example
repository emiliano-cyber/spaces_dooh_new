# ════ BASE DE DATOS ════
DATABASE_URL=postgresql://spaces_user:PASSWORD@localhost:5432/spaces_prod

# ════ REDIS ════
REDIS_URL=redis://localhost:6379

# ════ AUTENTICACIÓN ════
JWT_SECRET=GENERA_CON_openssl_rand_-base64_64
# Sin COOKIE_DOMAIN a propósito: las cookies son host-only y ninguna instancia
# comparte sesión con otro dominio (`lib/server/auth.ts:191-201` y `:216-226` no
# fijan `domain`; además ningún archivo de `apps/` lee la variable).
#
# Esta plantilla proponía `COOKIE_DOMAIN=.{TENANT_SLUG}.spaces.com` — una cookie
# COMODÍN de segundo nivel, del modelo de subdominios por tenant que murió el
# 12/08/2026. No hacía nada hoy, pero el código que sí lee la variable sigue en
# el repo (`_archive/api/src/core/auth/auth.routes.ts:17`): el día que el
# `domain` de la cookie se vuelva configurable, cada instancia nacida de esta
# plantilla habría compartido sesión por todo `*.spaces.com`. Y mientras tanto
# mandaba al operador a pedir DNS y certificados comodín para un modelo muerto.

# ════ DIGITALOCEAN SPACES ════
DO_SPACES_KEY=TU_SPACES_ACCESS_KEY
DO_SPACES_SECRET=TU_SPACES_SECRET_KEY
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=spaces-{TENANT_SLUG}
DO_SPACES_CDN_URL=https://spaces-{TENANT_SLUG}.nyc3.cdn.digitaloceanspaces.com

# ════ EMAIL ════
# La variable se llama EMAIL_FROM, NO `RESEND_FROM`. Esta plantilla declaraba lo
# segundo y el código lee lo primero (lib/server/email.ts), así que quien
# desplegara siguiendo la plantilla se quedaba SIN CORREO y nada se lo decía:
# `emailHabilitado()` exige las dos variables y devuelve `false` en silencio.
# Comprobado el 07/08 contra el .env.production del droplet, que usa EMAIL_FROM.
#
# Las dos o ninguna: con RESEND_API_KEY puesta y EMAIL_FROM vacía, el usuario
# que pide recuperar su contraseña ve «revisa tu bandeja» y no le llega nada.
# El dominio de EMAIL_FROM tiene que estar verificado en Resend (verifica
# DOMINIOS por DNS, no direcciones sueltas).
RESEND_API_KEY=re_TU_API_KEY
EMAIL_FROM=no-reply@tu-dominio-verificado.com

# ════ BANDERAS DE LA INSTANCIA ════
# Auto-registro público ("Crear cuenta" en el login + el alta de empresa con
# Google). SIN prefijo NEXT_PUBLIC_ desde el 14/08/2026: ya no se hornea en el
# build, se lee al arrancar, así que la misma imagen sirve a toda la flota.
# Por decisión del 14/08/2026 va CERRADO en TODA la flota — local, producción y
# DEMO incluidas. Ninguna instancia lo abre hoy. Basta con omitir la variable
# (ausente = cerrado); se deja escrita en 0 para que quede dicho, no supuesto.
AUTOREGISTRO=0

# ════ APP ════
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_API_URL=https://{TENANT_SLUG}.spaces.com/api
LOG_LEVEL=info

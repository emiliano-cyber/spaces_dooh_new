# SPACE EYE — ai-worker
# Redis (misma instancia que usa BullMQ en el backend)
REDIS_URL=redis://127.0.0.1:6379

# URL base del backend para los endpoints /api/internal/* y la descarga de fotos
API_BASE=http://127.0.0.1:4000

# Debe coincidir EXACTAMENTE con WORKER_SECRET del backend
WORKER_SECRET=change_me_worker_shared_secret_min_16_chars

# Segundos entre sondeos de la cola cuando no hay jobs
POLL_INTERVAL=5

# ============================================================================
#  Space Eye — la imagen que corre DENTRO de cada instancia de SPACE OS.
# ----------------------------------------------------------------------------
#  docker build -f Dockerfile.instancia -t space-eye:<version> .
#
#  A diferencia de backend/Dockerfile (el Space Eye central, que monta el
#  frontend desde el repositorio), en una instancia NO hay repositorio en el
#  servidor: todo lo que el contenedor necesita viene aqui adentro.
#
#    - el servidor compilado            /app/dist
#    - sus migraciones                  /app/migrations   (node dist/migrar.js)
#    - el panel de operacion            /frontend
#
#  Lo unico que NO viene es lo propio de cada empresa, que va en volumenes: las
#  fotos (/app/storage) y sus instaladores (/descargas, DESCARGAS_DIR), porque
#  la APK de una empresa esta compilada contra SU servidor.
#
#  La misma imagen para todas las instancias: lo que cambia es configuracion
#  (/etc/space-os/eyes.env), nunca codigo.
# ============================================================================
FROM node:22-slim AS build
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY backend/migrations ./migrations
COPY frontend /frontend
# Las descargas de la empresa (APK, agentes) se publican en este volumen.
RUN mkdir -p /descargas /app/storage
ENV DESCARGAS_DIR=/descargas
ARG VERSION=dev
ENV SPACE_EYE_VERSION=${VERSION}
LABEL org.opencontainers.image.title="space-eye" org.opencontainers.image.version="${VERSION}"
EXPOSE 4000
CMD ["node", "dist/server.js"]
